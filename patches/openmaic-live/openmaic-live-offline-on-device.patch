+/**
+ * Rewrite CDN references with local mirrors (served from /public) to
+ * same-origin URLs so widgets work fully offline.
+ */
+function localizeExternalResources(html: string): string {
+  return (
+    html
+      // Tailwind Play CDN → local bundle (/libs/tailwind/tailwindcss.js)
+      .replace(
+        /(src=["'])https?:\/\/cdn\.tailwindcss\.com[^"']*(["'])/gi,
+        '$1/libs/tailwind/tailwindcss.js$2',
+      )
+      // KaTeX on jsDelivr (any version) → local dist (/katex/...)
+      .replace(
+        /((?:src|href)=["'])https?:\/\/cdn\.jsdelivr\.net\/npm\/katex@[^/]+\/dist\/([^"']+)(["'])/gi,
+        '$1/katex/$2$3',
+      )
+      // CodeMirror on cdnjs → local mirror (/libs/codemirror/<ver>/...)
+      .replace(
+        /https?:\/\/cdnjs\.cloudflare\.com\/ajax\/libs\/codemirror\/([\d.]+)\//gi,
+        '/libs/codemirror/$1/',
+      )
+  );
+}
+
+/**
+ * Remove references to remaining external http(s) resources so the widget
+ * renders fully offline. Inline <script>/<style> content is untouched.
+ */
+function stripExternalResources(html: string): string {
+  return (
+    html
+      // <script src="https://..."></script> (e.g. Pyodide, three.js, web fonts)
+      .replace(/<script[^>]*\ssrc=["']https?:\/\/[^"']*["'][^>]*>\s*<\/script>/gi, '')
+      // <link rel="stylesheet|preconnect" href="https://..."> and font links
+      .replace(/<link[^>]*\shref=["']https?:\/\/[^"']*["'][^>]*\/?>/gi, '')
+      // @import url(https://...) inside <style> blocks
+      .replace(/@import\s+url\(["']?https?:\/\/[^"')]+\)["']?\s*;?/gi, '')
+  );
+}
