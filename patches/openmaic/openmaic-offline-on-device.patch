@@ -0,0 +1,112 @@
+/**
+ * Page Brief Expander
+ *
+ * Runtime port of the eval/slide-layout page-brief idea: that tool
+ * reconstructs detailed per-page briefs offline to build training pairs;
+ * this module does the same authoring job at runtime — turning the short
+ * outline (title + 1-2 sentence description + keyPoints) into a detailed,
+ * self-contained generation brief before content generation runs.
+ *
+ * Fail-closed: any parse/validation failure returns null and the caller
+ * falls back to the raw outline fields.
+ */
+
+import { buildPrompt, PROMPT_IDS } from './prompts/index.js';
+import { parseJsonResponse } from './json-repair.js';
+import type { GenerationLogger } from './logger.js';
+import { noopGenerationLogger } from './logger.js';
+
+export interface ExpandableOutline {
+  title: string;
+  description?: string;
+  keyPoints?: string[];
+  widgetType?: string;
+  widgetOutline?: { concept?: string; keyVariables?: string[] } | undefined;
+}
+
+export interface ExpandedPageBrief {
+  /** Slide path: full hq3-style generation request */
+  brief?: string;
+  /** Widget path: enriched slots for the {type}-content templates */
+  conceptOverview?: string;
+  designIdea?: string;
+  keyPoints?: string[];
+  variables?: string[];
+}
+
+export async function expandPageBrief(
+  outline: ExpandableOutline,
+  aiCall: (system: string, user: string) => Promise<string>,
+  options?: { languageDirective?: string; courseContext?: string; logger?: GenerationLogger },
+): Promise<ExpandedPageBrief | null> {
+  const log = options?.logger ?? noopGenerationLogger;
+  try {
+    const isWidget = !!outline.widgetType;
+    const widgetSection = isWidget
+      ? [
+          '- **输出形态**: 互动页（conceptOverview / designIdea / keyPoints / variables）',
+          `- **组件类型**: ${outline.widgetType}`,
+          `- **组件概念**: ${outline.widgetOutline?.concept || outline.title}`,
+          `- **候选变量**: ${(outline.widgetOutline?.keyVariables ?? []).join('、') || '无'}`,
+        ].join('\n')
+      : '- **输出形态**: 普通页（brief）';
+
+    const prompts = buildPrompt(PROMPT_IDS.PAGE_BRIEF_EXPANDER, {
+      title: outline.title,
+      pageType: outline.widgetType ? `interactive / ${outline.widgetType}` : 'slide',
+      widgetSection,
+      description: outline.description || '',
+      keyPoints: (outline.keyPoints || []).map((p, i) => `${i + 1}. ${p}`).join('\n'),
+      courseContext: options?.courseContext || '',
+      languageDirective: options?.languageDirective || '',
+    });
+    if (!prompts) {
+      log.warn(`Failed to build brief expander prompt for "${outline.title}"`);
+      return null;
+    }
+
+    const response = await aiCall(prompts.system, prompts.user);
+    const parsed = parseJsonResponse<ExpandedPageBrief>(response);
+    if (!parsed) {
+      log.warn(
+        `Brief expansion returned unparseable response for "${outline.title}": ${response.slice(0, 200)}`,
+      );
+      return null;
+    }
+
+    // Small models sometimes rename conceptOverview to content/overview — accept aliases.
+    const record = parsed as Record<string, unknown>;
+    if (!parsed.conceptOverview) {
+      const alias = record.content ?? record.overview;
+      if (typeof alias === 'string' && alias.trim()) parsed.conceptOverview = alias.trim();
+    }
+
+    if (isWidget) {
+      const coLen = parsed.conceptOverview?.length ?? 0;
+      const diLen = parsed.designIdea?.length ?? 0;
+      if (coLen < 50 || diLen < 50) {
+        log.warn(
+          `Brief expansion too short for "${outline.title}" (conceptOverview=${coLen}, designIdea=${diLen}), falling back to raw outline`,
+        );
+        return null;
+      }
+    } else {
+      const briefLen = parsed.brief?.length ?? 0;
+      if (briefLen < 100) {
+        log.warn(
+          `Brief expansion too short for "${outline.title}" (brief=${briefLen}), falling back to raw outline: ${(parsed.brief ?? '').slice(0, 200)}`,
+        );
+        return null;
+      }
+    }
+
+    const size = parsed.brief?.length ?? parsed.conceptOverview?.length ?? 0;
+    log.info(
+      `Brief expanded for "${outline.title}" (${outline.widgetType ?? 'slide'}): ~${size} chars`,
+    );
+    return parsed;
+  } catch (error) {
+    log.warn(`Brief expansion failed for "${outline.title}", falling back to raw outline:`, error);
+    return null;
+  }
+}
